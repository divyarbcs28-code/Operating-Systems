#include <stdlib.h>

#define MAX_KEY 10001

typedef struct Node {
    int key;
    int value;
    struct Node *prev;
    struct Node *next;
} Node;

typedef struct {
    int capacity;
    int size;
    Node *head;              // Most recently used
    Node *tail;              // Least recently used
    Node *map[MAX_KEY];      // key -> node
} LRUCache;

static void removeNode(LRUCache *cache, Node *node) {
    if (node->prev)
        node->prev->next = node->next;
    else
        cache->head = node->next;

    if (node->next)
        node->next->prev = node->prev;
    else
        cache->tail = node->prev;
}

static void addToFront(LRUCache *cache, Node *node) {
    node->prev = NULL;
    node->next = cache->head;

    if (cache->head)
        cache->head->prev = node;
    else
        cache->tail = node;

    cache->head = node;
}

LRUCache* lRUCacheCreate(int capacity) {
    LRUCache *cache = malloc(sizeof(LRUCache));

    cache->capacity = capacity;
    cache->size = 0;
    cache->head = NULL;
    cache->tail = NULL;

    for (int i = 0; i < MAX_KEY; i++)
        cache->map[i] = NULL;

    return cache;
}

int lRUCacheGet(LRUCache* cache, int key) {
    Node *node = cache->map[key];

    if (node == NULL)
        return -1;

    // Mark the node as most recently used.
    removeNode(cache, node);
    addToFront(cache, node);

    return node->value;
}

void lRUCachePut(LRUCache* cache, int key, int value) {
    Node *node = cache->map[key];

    if (node != NULL) {
        // Update existing key and mark it as most recently used.
        node->value = value;
        removeNode(cache, node);
        addToFront(cache, node);
        return;
    }

    node = malloc(sizeof(Node));
    node->key = key;
    node->value = value;

    addToFront(cache, node);
    cache->map[key] = node;
    cache->size++;

    if (cache->size > cache->capacity) {
        Node *leastRecentlyUsed = cache->tail;

        removeNode(cache, leastRecentlyUsed);
        cache->map[leastRecentlyUsed->key] = NULL;
        free(leastRecentlyUsed);

        cache->size--;
    }
}

void lRUCacheFree(LRUCache* cache) {
    Node *current = cache->head;

    while (current != NULL) {
        Node *next = current->next;
        free(current);
        current = next;
    }

    free(cache);
}
